[Unit]
Description=TESL-Panel (download page + build-publish API)
After=network.target

[Service]
Type=simple
User=__SERVICE_USER__
WorkingDirectory=__PROJECT_DIR__
# Живой инцидент (2026-09-24): journalctl показывал на каждом старте
# "[ERROR] Control server error: [Errno 13] Permission denied:
# '/home/__SERVICE_USER__'" — не фатально (воркеры всё равно
# поднимались, сервис отвечал), но шумело в логе на каждый рестарт.
# Причина: `useradd --system --no-create-home` (см. deploy.sh) даёт
# юзеру запись HOME=/home/__SERVICE_USER__ в /etc/passwd, даже когда
# сама директория никогда не создавалась — systemd подставляет этот
# $HOME процессу как есть, а сам каталог /home пользователю не
# принадлежит и недоступен на запись, так что что бы ни пыталось
# создать там файл (control-сокет/кэш gunicorn) — падает с Permission
# denied. /tmp всегда доступен на запись любому пользователю (sticky
# bit) — простой, стандартный фикс для этого класса "юзер без home".
Environment=HOME=/tmp
EnvironmentFile=__PROJECT_DIR__/panel.env
# Живой инцидент (2026-09-30): `--workers 2` (голый sync-воркер класс)
# означал буквально ДВА одновременных запроса на весь сервис — лаунчер
# TESL качает чанки/паки до `CHUNK_MAX_WORKERS=24` параллельными HTTP-
# соединениями, каждое из которых держит sync-воркер занятым на всё
# время передачи файла (блокирующее чтение с диска + отдача байт).
# С двумя воркерами это означало: 22 из 24 запросов лаунчера стоят в
# очереди у nginx, а ЛЮБОЙ другой запрос (даже тривиальный GET
# /api/builds) — тоже встаёт в ту же очередь позади них. Живой
# симптом: `curl https://.../api/builds` с реального клиентского ПК
# зависал на 20+ секунд с нулём полученных байт — TCP/TLS проходили
# мгновенно (не сеть, не Cloudflare), само приложение просто не
# успевало освободить воркер для нового запроса.
# Фикс — `gthread` вместо голого `sync`: то же число ПРОЦЕССОВ (дёшево
# по памяти), но каждый обслуживает несколько потоков параллельно —
# 2 процесса * 16 потоков = до 32 одновременных запросов, с запасом
# над `CHUNK_MAX_WORKERS=24` + обычный admin/API-трафик поверх этого.
# `gthread` встроен в gunicorn (не требует gevent/eventlet как
# отдельную зависимость в requirements.txt).
ExecStart=__PROJECT_DIR__/.venv/bin/gunicorn --workers 2 --threads 16 --worker-class gthread --bind 127.0.0.1:__PORT__ --timeout 300 wsgi:app
Restart=on-failure
RestartSec=5

# NoNewPrivileges=true раньше стояло здесь (депо может быть крупным —
# десятки-сотни ГБ чанков, сервис по идее пишет только внутрь
# STORAGE_ROOT/WorkingDirectory, ничего больше трогать не должен) — снято
# 2026-09-23 ради self-update из /admin/settings (см. panel/self_update.py
# и CLAUDE.md "Self-update панели"): git pull + systemctl restart идут
# через sudo -n на ДВЕ конкретные команды (см. deploy.sh, "sudoers для
# self-update"), а sudo — setuid-бинарник, NoNewPrivileges=true запрещает
# ЛЮБУЮ эскалацию через setuid/setcap целиком, включая эту. Прямой
# trade-off: сервис и так уже мог писать любой файл под STORAGE_ROOT (это
# его основная работа), новые sudo-права — ровно две явно перечисленные в
# sudoers команды, не root целиком.

[Install]
WantedBy=multi-user.target
