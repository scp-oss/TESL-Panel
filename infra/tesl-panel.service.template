[Unit]
Description=TESL-Panel (download page + build-publish API)
After=network.target

[Service]
Type=simple
User=__SERVICE_USER__
WorkingDirectory=__PROJECT_DIR__
EnvironmentFile=__PROJECT_DIR__/panel.env
ExecStart=__PROJECT_DIR__/.venv/bin/gunicorn --workers 2 --bind 127.0.0.1:__PORT__ --timeout 300 wsgi:app
Restart=on-failure
RestartSec=5

# NoNewPrivileges=true раньше стояло здесь (депо может быть крупным —
# десятки-сотни ГБ чанков, сервис по идее пишет только внутрь
# STORAGE_ROOT/WorkingDirectory, ничего больше трогать не должен) — снято
# 2026-09-23 ради self-update из /admin/settings (см. panel/self_update.py
# и CLAUDE.md "Self-update панели"): git pull + systemctl restart идут
# через sudo -n на ДВЕ конкретные команды (см. deploy.sh, "sudoers для
# self-update"), а sudo — setuid-бинарник, NoNewPrivileges=true запрещает
# ЛЮБУЮ эскалацию через setuid/setcap целиком, включая эту. Прямой
# trade-off: сервис и так уже мог писать любой файл под STORAGE_ROOT (это
# его основная работа), новые sudo-права — ровно две явно перечисленные в
# sudoers команды, не root целиком.

[Install]
WantedBy=multi-user.target
