# Плейсхолдеры (__X__) заполняются infra/deploy.sh — не редактировать руками,
# не коммитить с реальными значениями (домен/пути — ДСП, см. CLAUDE.md).
#
# TLS — Cloudflare Origin Certificate, НЕ Let's Encrypt/certbot: порты
# 80/443 на этом сервере уже заняты другими проектами под certbot
# (nethunter.sytes.net и т.д.), трогать их нельзя — тот же принцип, что и
# у read-only nginx-плана в TESL-Manager (nginx-depot-read.conf.template).
# Публичный TLS для пользователя терминируется на Cloudflare (домен
# должен быть на "Proxied", оранжевое облако); сюда нужен сертификат,
# которому доверяет только Cloudflare — SSL/TLS -> Origin Server ->
# Create Certificate в дэшборде, 15 лет, бесплатно. SSL/TLS mode на
# Cloudflare — "Full (strict)".

server {
    listen 443 ssl;
    listen [::]:443 ssl;
    http2 on;
    server_name __DOMAIN__;

    ssl_certificate     __ORIGIN_CERT__;
    ssl_certificate_key __ORIGIN_KEY__;

    # Живой инцидент (2026-09-24): этот лимит был рассчитан на одиночные
    # чанки (максимум 4MB) — TESL-Manager с тех пор научился публиковать
    # укрупнёнными pack-файлами (см. TESL-Manager/depot_sync_manager/
    # pack_writer.py, "Живой инцидент" там же за полную картину), и
    # реальная публикация на проде падала с 413 (тело запроса больше
    # лимита), пока это не было исправлено — ни в одном логе панели это
    # даже не появлялось, 413 отдаёт сам nginx, до того как запрос вообще
    # достигает Flask/gunicorn. 200m — с запасом выше текущих pack-файлов
    # (максимум 96MB, HDD-режим), но заведомо НИЖЕ жёсткого лимита тела
    # запроса на бесплатных/Pro тарифах Cloudflare (~100MB) может не
    # иметь значения — если сервер стоит за Cloudflare Proxied на таком
    # тарифе, тот лимит применяется на уровне Cloudflare ДО того, как
    # запрос вообще доходит до этого nginx, и этот параметр его не
    # обходит. См. тот же комментарий в pack_writer.py — pack-файлы
    # держатся ощутимо ниже 100MB именно по этой причине.
    client_max_body_size 200m;

    # Тот же инцидент — дефолтных таймаутов nginx (60с на тело/чтение/
    # запись) может не хватить на крупный pack-файл при медленном канале
    # оператора; с запасом до 5 минут на один запрос.
    client_body_timeout   300s;
    proxy_read_timeout    300s;
    proxy_send_timeout    300s;

    location / {
        proxy_pass http://127.0.0.1:__PORT__;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }
}

# HTTP -> HTTPS редирект — на случай обращения мимо Cloudflare (Full
# (strict) требует, чтобы origin сам поддерживал TLS, порт 80 не должен
# отвечать голым HTTP).
server {
    listen 80;
    listen [::]:80;
    server_name __DOMAIN__;
    return 301 https://$host$request_uri;
}
