server {
    listen 80;
    listen [::]:80;
    server_name __DOMAIN__;

    # certbot --nginx переключит этот server-блок на 443 и допишет ssl_*
    # директивы сам, после первого успешного выпуска сертификата — этот
    # файл до certbot нарочно HTTP-only.

    client_max_body_size 64m;   # с запасом сверх максимального размера чанка (4MB, config.py)

    location / {
        proxy_pass http://127.0.0.1:__PORT__;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }
}
